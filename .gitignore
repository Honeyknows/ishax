# =============================================================================
# ISHAX EDR - Enterprise Git Ignore Rules
# =============================================================================

# --- Environment & Secret Configuration ---
.env
.env.local
.env.*.local
*.secret

# --- Python & Runtime Caches ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.pytest_cache/

# --- Node.js & Frontend Build Artifacts ---
server/frontend/node_modules/
server/frontend/dist/
server/frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Runtime Databases & WAL Journal Files ---
server/pipeline/tenants/tenant_*.db
server/pipeline/tenants/tenant_*.db-wal
server/pipeline/tenants/tenant_*.db-shm
*.db-wal
*.db-shm

# --- Dynamic Installer Output & Local Binaries ---
endpoint/Output/
!endpoint/Sysmon64.exe
!endpoint/amsi_watcher.exe

# --- Telemetry & System Log Files ---
*.log
*.log.err
*.pid
server/wazuh/logs/archives/archives.json
server/wazuh/logs/archives/archives.log
server/wazuh/logs/archives/20*
server/wazuh/logs/alerts/
server/wazuh/logs/wazuh/
server/wazuh/logs/api.log
server/wazuh/logs/ossec.log

# --- IDE & System Metadata ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
